<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.shadydevelopment.echotv</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>ECHO TV</name>
  <developer_name>Antonio Martinovic @ ShadyDevelopment</developer_name>
  <summary>Open-source IPTV player for M3U, Xtream Codes, and Stalker portals</summary>
  <launchable type="desktop-id">com.shadydevelopment.echotv.desktop</launchable>

  <description>
    <p>ECHO TV is a cross-platform IPTV player for user-supplied playlists and portal connections.</p>
    <p>It supports M3U and M3U8 playlists, Xtream Codes API, and Stalker portals with EPG, catch-up, favorites, and external player integration.</p>
    <p>The app does not include channels, playlists, or media catalogs. Any IPTV sources, logos, metadata, and programme information come from services the user configures.</p>
  </description>

  <categories>
    <category>AudioVideo</category>
    <category>Player</category>
    <category>Video</category>
  </categories>

  <keywords>
    <keyword>IPTV</keyword>
    <keyword>M3U</keyword>
    <keyword>M3U8</keyword>
    <keyword>EPG</keyword>
    <keyword>Xtream</keyword>
    <keyword>Stalker</keyword>
  </keywords>

  <url type="homepage">https://github.com/ShadyDevelopment/ECHO_TV</url>
  <url type="bugtracker">https://github.com/ShadyDevelopment/ECHO_TV/issues</url>
  <url type="help">https://github.com/ShadyDevelopment/ECHO_TV</url>

  <content_rating type="oars-1.0"/>

  <releases>
    <release version="0.20.0" type="development" date="2026-02-21"/>
    <release version="0.19.0" type="stable" date="2026-02-11"/>
  </releases>

